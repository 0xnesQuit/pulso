{
  "package": "app.pulsoband.claude",
  "name": "Claude",
  "versionName": "1.2",
  "versionCode": 3,
  "minPlatformVersion": 1100,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.interconnect"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 212
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index",
        "launchMode": "singleTask"
      }
    },
    "widgets": {
      "Card": {
        "name": "Claude",
        "description": "Claude limitleri",
        "component": "index",
        "path": "/Card",
        "features": [
          {
            "name": "system.storage"
          },
          {
            "name": "system.router"
          }
        ]
      },
      "LiteCard": {
        "name": "Claude",
        "description": "Claude limitleri",
        "component": "index",
        "path": "/LiteCard",
        "type": "lite",
        "minCardPlatformVersion": 2000,
        "features": []
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
