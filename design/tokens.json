    "hairlineStrong": { "dark": "#393C41", "light": "#D0D1D2", "darkContrast": "#686C74", "lightContrast": "#86888C", "note": "arc and slider tracks, chart baseline; contrast values (3:1 on surface) are a v3 addition" },
    "textPrimary": { "dark": "#F4F4F4", "light": "#171A20", "note": "15.8:1 on surface" },
    "textBody": { "dark": "#D0D1D2", "light": "#393C41" },
    "textSecondary": { "dark": "#A2A4A9", "light": "#5C5E62", "darkContrast": "#C4C6CA", "lightContrast": "#45474B", "note": "axes, captions; 7.0 / 5.9:1 on surface" },
    "textTertiary": { "dark": "#6E7178", "light": "#8E8E8E", "darkContrast": "#8B8E95", "lightContrast": "#6E7075", "note": "placeholder and disabled only (fails 4.5:1 on purpose); contrast values are a v3 addition" },
    "action": { "dark": "#3E6AE1", "light": "#3E6AE1", "note": "primary buttons and on-state toggles only; never a text colour" },
    "actionPressed": { "dark": "#3457B1", "light": "#3457B1" },
    "onAction": { "dark": "#FFFFFF", "light": "#FFFFFF", "note": "label on action: 4.82 / 6.68:1" },
    "destructive": { "dark": "#F0675B", "light": "#A8261B", "note": "destructive button label: low lifted in dark to clear 4.5:1 on raised sheets (v3 addition)" },
    "good": { "dark": "#3CCB7F", "light": "#1A9A5C", "note": "score band; shared by Sleep and Recovery" },
